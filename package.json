{
  "name": "dowse-obsidian",
  "version": "0.1.0",
  "description": "Find anything in your vault by what's in it: notes, PDFs, images, recordings and videos, searched by meaning, on your computer.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "measure": "node scripts/measure-model.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "esbuild": "0.25.12",
    "esbuild-svelte": "0.9.5",
    "fake-indexeddb": "6.2.5",
    "obsidian": "1.14.4",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "stemmer": "2.0.1",
    "svelte": "5.57.2",
    "three": "0.186.1",
    "xz-decompress": "0.2.3"
  }
}
